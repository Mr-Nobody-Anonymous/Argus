# ─────────────────────────────────────────────────────────────────────────────
# Argus environment configuration
#
#   cp .env.example .env      then edit .env (it is git-ignored)
#
# Values referenced in config/config.yaml as ${VAR} or ${VAR:-default} are
# substituted at load time, so no secret ever needs to live in the YAML.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication (REQUIRED in production) ──
# Signing key for JWTs. Generate with:  openssl rand -base64 48
# If unset, the server generates an ephemeral key: tokens are invalidated on
# every restart and a warning is emitted. Never ship without setting this.
ARGUS_JWT_SECRET=

# Token lifetimes
ARGUS_ACCESS_TOKEN_MINUTES=30
ARGUS_REFRESH_TOKEN_DAYS=7

# Login throttling (per client IP + username)
ARGUS_LOGIN_MAX_ATTEMPTS=5
ARGUS_LOGIN_LOCKOUT_SECONDS=300

# Escape hatch for local single-user development ONLY.
# Set to 1 to disable all authentication. The API logs a prominent warning and
# /api/v1/health reports auth_enabled=false. Never enable outside a laptop.
# ARGUS_DISABLE_AUTH=0

# ── CORS ──
# Comma-separated list of allowed browser origins.
ARGUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional regex for dynamic hosts (tunnels, preview environments).
# Leave EMPTY in production - a broad regex disables origin checking entirely.
# ARGUS_CORS_ORIGIN_REGEX=

# ── Credentials referenced from config.yaml ──
# MQTT_USERNAME=
# MQTT_PASSWORD=
# RTSP_USERNAME=
# RTSP_PASSWORD=

# ── Database (when moving off SQLite) ──
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=argus
# POSTGRES_USER=argus
# POSTGRES_PASSWORD=

# ── Observability ──
# Log output format: "text" (default, human readable) or "json" (for Loki,
# Elasticsearch, CloudWatch ingestion).
ARGUS_LOG_FORMAT=text
ARGUS_LOG_LEVEL=INFO
# Prometheus metrics are exposed unauthenticated at GET /metrics, matching the
# convention for /health. They contain operational counters only - no frames,
# identities, or event contents. Restrict at the network layer if required.
