# ─────────────────────────────────────────────────────────────────────────────
# Argus environment configuration
#
#   cp .env.example .env      then edit .env (it is git-ignored)
#
# Values referenced in config/config.yaml as ${VAR} or ${VAR:-default} are
# substituted at load time, so no secret ever needs to live in the YAML.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication (REQUIRED in production) ──
# Signing key for JWTs. Generate with:  openssl rand -base64 48
# If unset, the server generates an ephemeral key: tokens are invalidated on
# every restart and a warning is emitted. Never ship without setting this.
ARGUS_JWT_SECRET=

# ── Deployment (containers / hosting platforms) ──
# Where all mutable state is written: SQLite database, snapshots, evidence
# clips, model cache. Interpolated into config/config.yaml.
#
# On ANY container platform this must point at a mounted volume, or the
# database is wiped on every restart and redeploy. Mounting a disk at some
# other path is the most common deployment mistake: the app writes to the
# container filesystem while an empty volume sits beside it, and nothing looks
# wrong until the first restart. See docs/DEPLOYMENT.md.
# ARGUS_DATA_DIR=/app/data

# Sets the initial admin password on first boot, so no default password is ever
# baked into an image. If left unset, a random secure password is generated.
# ARGUS_ADMIN_PASSWORD=

# ── Biometric Data Encryption (Face Embeddings at Rest) ──
# 32-byte hex/base64 key used for AES-256-GCM encryption of biometric embeddings.
# If unset, Argus securely generates and persists a key at data/.biometric.key.
# ARGUS_BIOMETRIC_KEY=

# ── Database Connection ──
# Default is SQLite for local/single-user deployment.
# For production multi-camera deployment, point to PostgreSQL:
# DATABASE_URL=postgresql://argus:password@localhost:5432/argus
DATABASE_URL=sqlite:///data/argus.db

# Interface the production compose file publishes on. Defaults to 127.0.0.1
# (local only). Set to 0.0.0.0 to expose on the network - put TLS in front
# first; Argus streams identifiable footage.
# ARGUS_BIND=127.0.0.1
# Development compose ports are loopback-only unless explicitly widened.
# ARGUS_DEV_BIND=127.0.0.1

# PORT is injected automatically by Render/Railway/Fly/Cloud Run and honoured
# by the container entrypoint. Only set it manually for a bare-metal install.
# PORT=8000

# Token lifetimes
ARGUS_ACCESS_TOKEN_MINUTES=30
ARGUS_REFRESH_TOKEN_DAYS=7

# Login throttling (per client IP + username)
ARGUS_LOGIN_MAX_ATTEMPTS=5
ARGUS_LOGIN_LOCKOUT_SECONDS=300

# Escape hatch for local single-user development ONLY.
# Set to 1 to disable all authentication. The API logs a prominent warning and
# /api/v1/health reports auth_enabled=false. Never enable outside a laptop.
# ARGUS_DISABLE_AUTH=0

# ── CORS ──
# Comma-separated list of allowed browser origins.
ARGUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional regex for dynamic hosts (tunnels, preview environments).
# Leave EMPTY in production - a broad regex disables origin checking entirely.
# ARGUS_CORS_ORIGIN_REGEX=

# Comma-separated list of allowed Host header domains (prevents Host Header Injection)
# ARGUS_ALLOWED_HOSTS=argus.example.com,localhost,127.0.0.1

# ── Credentials referenced from config.yaml ──
# MQTT_USERNAME=
# MQTT_PASSWORD=
# RTSP_USERNAME=
# RTSP_PASSWORD=

# ── Database (when moving off SQLite) ──
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=argus
# POSTGRES_USER=argus
# POSTGRES_PASSWORD=

# ── Observability ──
# Log output format: "text" (default, human readable) or "json" (for Loki,
# Elasticsearch, CloudWatch ingestion).
ARGUS_LOG_FORMAT=text
ARGUS_LOG_LEVEL=INFO
# Prometheus metrics are exposed unauthenticated at GET /metrics, matching the
# convention for /health. They contain operational counters only - no frames,
# identities, or event contents. Restrict at the network layer if required.
