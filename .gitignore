.argus/
.env

# JavaScript
node_modules/
dist/
build/
.DS_Store

# Data & Database
*.db
*.sqlite
data/*
# Keep the demo fixture: tests/test_regression.py and tests/swarm_benchmark.py
# both require it, and it cannot be regenerated faithfully without a real
# street photograph (YOLO returns nothing on drawn shapes).
# NOTE: this must be `data/*`, not `data/` - git will not re-include a file
# that sits inside an excluded directory.
snapshots/
backend/data/
mosquitto/data/
mosquitto/log/

# Media Files (Don't push large videos)
*.mp4
*.avi
*.mov
*.mkv

# AI Models (Don't push large binary models)
*.pt
*.onnx
yolov8*.pt

# IDE
.vscode/
.idea/

# ── Added during production hardening ──
frontend/dist/
frontend/node_modules/
data/argus_django.db

# ── Demo fixture (must be last: a negation only wins if no LATER rule
# re-excludes the path, and `*.mp4` above would otherwise catch it) ──
# tests/test_regression.py and tests/swarm_benchmark.py both require this clip,
# and it cannot be regenerated faithfully without a real street photograph.
!data/demo_clip.mp4
